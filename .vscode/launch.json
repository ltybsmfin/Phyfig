{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Physics editor (Debug)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/vs2022/bin/editor/Debug/physics_editor.exe",
      "args": ["--validation"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug selected CMake target",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "cwd": "${command:cmake.launchTargetDirectory}",
      "console": "integratedTerminal"
    }
  ]
}
